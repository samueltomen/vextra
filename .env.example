# Configuration de CronPing en auto-hébergement (docker compose).
# Copiez ce fichier en `.env`, remplissez-le et NE LE COMMITEZ JAMAIS.

# --- Obligatoire -------------------------------------------------------------

# URL publique exacte de l'application, sans « / » final. Elle sert à la garde
# d'origine, aux cookies de session et aux liens des e-mails.
APP_ORIGIN=https://cronping.exemple.org

# Votre projet Supabase (cloud ou auto-hébergé) :
# Project Settings > API.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=remplacez-par-la-cle-publique-anon-ou-publishable
# Secrète : ne l'exposez jamais au navigateur.
SUPABASE_SERVICE_ROLE_KEY=remplacez-par-la-cle-service-role

# Deux secrets aléatoires d'au moins 32 caractères :
#   openssl rand -base64 48
SESSION_ENCRYPTION_KEY=generez-une-valeur-aleatoire-de-48-octets
# Ne changez JAMAIS cette valeur après coup : tous les tokens de ping seraient
# invalidés.
PING_TOKEN_PEPPER=generez-une-autre-valeur-aleatoire-de-48-octets

# --- Serveur (facultatif) ----------------------------------------------------

# PORT=8787

# Fermer les inscriptions une fois votre compte créé (installation personnelle).
# SIGNUPS_ENABLED=false

# Derrière un proxy de confiance, en-tête qui contient l'IP du client
# (limitation de débit). Sans proxy, laissez vide : l'IP de la connexion est
# utilisée. N'activez cette option que si le proxy réécrit toujours l'en-tête.
# CLIENT_IP_HEADER=x-forwarded-for

# --- E-mail des alertes et du rapport hebdomadaire (choisissez UNE option) ----
# Sans configuration, aucun e-mail n'est envoyé (les canaux Slack, Discord, etc.
# restent disponibles et se règlent dans l'interface).

# Option A : Resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=CronPing <alertes@exemple.org>

# Option B : serveur SMTP
# SMTP_HOST=smtp.exemple.org
# SMTP_PORT=587
# Mettez SMTP_SECURE=true pour le port 465 (TLS implicite).
# SMTP_SECURE=false
# SMTP_USER=utilisateur
# SMTP_PASSWORD=mot-de-passe
# EMAIL_FROM=CronPing <alertes@exemple.org>
# Si les deux options sont renseignées : EMAIL_PROVIDER=resend ou smtp.
# EMAIL_PROVIDER=smtp
